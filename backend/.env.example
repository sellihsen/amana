# ============================================================================
# Variables d'environnement — Backend
#
# Toutes les variables marquées « REQUIS » sont validées au démarrage :
# une valeur absente, vide ou invalide interrompt le lancement de l'API.
# Aucune n'a de valeur de repli.
# ============================================================================

# ─── Serveur ────────────────────────────────────────────────────────────────
# Port d'écoute de l'API. Optionnel, défaut 3001.
PORT=3001

# REQUIS — Origine autorisée du frontend (CORS + cookie de session).
# URL absolue, sans barre oblique finale.
FRONTEND_URL=http://localhost:5173

# Environnement d'exécution : development | test | production.
# En production, le cookie de session devient Secure et /api-docs est désactivé.
NODE_ENV=development

# ─── Base de données PostgreSQL (≥ 14) ──────────────────────────────────────
# REQUIS — Hôte du serveur PostgreSQL.
DB_HOST=localhost

# REQUIS — Port PostgreSQL, entier de 1 à 65535.
DB_PORT=5432

# REQUIS — Nom de la base applicative.
DB_NAME=amana_db

# REQUIS — Utilisateur PostgreSQL.
DB_USER=postgres

# REQUIS — Mot de passe PostgreSQL. Ne doit pas être vide.
DB_PASSWORD=<remplacez_par_le_mot_de_passe>

# ─── Session ────────────────────────────────────────────────────────────────
# REQUIS — Clé de signature de la session, au moins 32 caractères.
# Générez-la, ne la réutilisez pas entre deux environnements :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<remplacez_par_une_cle_aleatoire_de_48_octets>

# REQUIS — Durée de validité de la session, par exemple 8h.
JWT_EXPIRES_IN=8h

# Nom du cookie de session. Optionnel, défaut « session ».
SESSION_COOKIE_NAME=session

# ─── Limites et documentation ───────────────────────────────────────────────
# Taille maximale du corps d'une requête. Optionnel, défaut 100kb.
REQUEST_BODY_LIMIT=100kb

# Active /api-docs en production (admin uniquement). Optionnel, défaut false.
API_DOCS_ENABLED=false

# ─── Tests ──────────────────────────────────────────────────────────────────
# Base jetable des tests d'intégration. Le nom DOIT se terminer par « _test ».
TEST_DB_NAME=amana_test

# Base de maintenance utilisée pour créer/supprimer la base de test.
MAINTENANCE_DB_NAME=postgres

# ─── Seed de développement ──────────────────────────────────────────────────
# Mot de passe du compte administrateur créé par `npm run seed`.
# Aucun défaut : le seed s'interrompt si la variable est absente, et refuse
# de s'exécuter avec NODE_ENV=production.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@mosquee.local
