# ═══════════════════════════════════════════════════════════════════════════
#  Amana — reverse proxy Nginx
#
#  Remplacer AMANA_DOMAINE par votre nom de domaine, puis :
#    sudo cp amana.conf /etc/nginx/sites-available/amana
#    sudo ln -s /etc/nginx/sites-available/amana /etc/nginx/sites-enabled/
#    sudo rm -f /etc/nginx/sites-enabled/default
#    sudo nginx -t && sudo systemctl reload nginx
#
#  Ce fichier décrit l'état AVANT TLS. Certbot ajoutera ensuite les directives
#  ssl_* et la redirection HTTP→HTTPS :
#    sudo certbot --nginx -d AMANA_DOMAINE --redirect
#
#  Deux points sont indispensables au bon fonctionnement de l'application :
#
#   • X-Forwarded-Proto — sans lui, Express croit servir du HTTP en clair et
#     refuse d'émettre le cookie de session marqué « Secure ». L'application
#     déclare `app.set('trust proxy', 1)` pour lui faire confiance.
#
#   • X-Forwarded-For — la limitation de débit sur la connexion et le journal
#     d'audit enregistreraient sinon l'adresse du proxy pour tout le monde.
# ═══════════════════════════════════════════════════════════════════════════

# Limitation de débit sur l'authentification, en amont de celle de
# l'application : les tentatives sont absorbées avant d'atteindre Node.
limit_req_zone $binary_remote_addr zone=amana_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name AMANA_DOMAINE;

    # Validation et renouvellement Let's Encrypt.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
    }

    location /api/auth/login {
        limit_req zone=amana_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # L'application borne déjà le corps des requêtes ; cette limite arrête les
    # charges excessives plus tôt.
    client_max_body_size 1m;

    # La version de Nginx ne renseigne personne d'utile.
    server_tokens off;
}
